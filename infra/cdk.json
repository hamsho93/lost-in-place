{
  "app": "uv run python app.py",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "tests", "**/__pycache__", ".venv"]
  },
  "context": {
    "region": "us-east-1",
    "budgetUsd": 450,
    "maxVcpus": 128,
    "alertEmail": "",
    "imageTag": "latest",
    "accountAlarmUsd": 0,
    "githubRepo": "hamsho93@17190997/lost-in-place@1411196677",
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true
  }
}
