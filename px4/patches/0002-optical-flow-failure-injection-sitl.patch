diff --git a/src/modules/simulation/gz_bridge/GZBridge.cpp b/src/modules/simulation/gz_bridge/GZBridge.cpp
index 51308d351f..7d7a32b484 100644
--- a/src/modules/simulation/gz_bridge/GZBridge.cpp
+++ b/src/modules/simulation/gz_bridge/GZBridge.cpp
@@ -391,6 +391,19 @@ void GZBridge::opticalFlowCallback(const px4::msgs::OpticalFlow &msg)
 	// This means that delta angle will come from vehicle gyro
 	// Distance will come from vehicle distance sensor
 
+	_flow_failure_config.update();
+	const failure_injection::Mode flow_mode = _flow_failure_config.mode(failure_injection_s::FAILURE_UNIT_SENSOR_OPTICAL_FLOW, 1);
+
+	// Off and Stuck first, so the Stuck cache only ever holds uncorrupted samples
+	if (!failure_injection::process(flow_mode, report, _flow_stuck)) {
+		return;
+	}
+
+	if (flow_mode == failure_injection::Mode::Wrong) {
+		// degraded tracking: data keeps arriving but the sensor reports it as untrustworthy
+		report.quality = 0;
+	}
+
 	_optical_flow_pub.publish(report);
 }
 
